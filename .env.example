# ─────────────────────────────────────────────────────────────────────────────
# ASSESSMENT PLATFORM – Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the service_role key for backend operations (keep secret!)
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
# Anon key is safe to expose in the frontend only
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── App Secrets ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY
# Session cookie name
SESSION_COOKIE_NAME=assessment_session
# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Admin ─────────────────────────────────────────────────────────────────────
# Initial admin email – must be registered first then promoted in DB
ADMIN_EMAIL=admin@yourorganization.com

# ── File Storage ──────────────────────────────────────────────────────────────
# "local" for development, "supabase" for production (Supabase Storage)
STORAGE_BACKEND=local
# Local upload directory (must be outside webroot)
UPLOAD_DIR=uploads/resumes
# Supabase Storage bucket name (must be private)
STORAGE_BUCKET=resumes
# Max resume size in bytes (default 5 MB)
MAX_RESUME_SIZE_BYTES=5242880

# ── Assessment / Payment ──────────────────────────────────────────────────────
ASSESSMENT_NAME=Professional Skills Assessment
ASSESSMENT_FEE=500
ASSESSMENT_CURRENCY=INR
PAYMENT_ACCOUNT_NAME=YOUR_ACCOUNT_NAME_HERE
# UPI ID for QR payments
PAYMENT_UPI_ID=yourname@upi

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Email (optional – for verification emails) ────────────────────────────────
# Leave SMTP_USER / SMTP_PASSWORD empty (or as the placeholders below) and emails are
# printed to the console instead – handy for development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
EMAIL_FROM=noreply@yourorganization.com
# Public URL of the site – used to build the links inside emails
APP_BASE_URL=http://127.0.0.1:8000

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Set to "true" in production to enforce HTTPS
FORCE_HTTPS=false
